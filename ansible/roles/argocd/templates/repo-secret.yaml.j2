# Inloggningen till gruppens repo. Argo CD hittar den på labeln.
apiVersion: v1
kind: Secret
metadata:
  name: grupprojekt-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  url: {{ argocd_repo_url | to_json }}
  username: {{ argocd_repo_user | to_json }}
  password: {{ argocd_repo_token | to_json }}
