# Inloggningen till gruppens repo. Argo CD hittar den på labeln.
apiVersion: v1
kind: Secret
metadata:
  name: grupprojekt-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
# data i stället för stringData: med stringData säger kubectl apply
# "configured" varje gång, även när inget har ändrats.
data:
  url: {{ argocd_repo_url | b64encode }}
  username: {{ argocd_repo_user | b64encode }}
  password: {{ argocd_repo_token | b64encode }}
