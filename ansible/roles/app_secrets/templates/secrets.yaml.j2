# Namespacen skapas här, eftersom secreten måste finnas innan Argo CD
# installerar appen som använder den.
apiVersion: v1
kind: Namespace
metadata:
  name: monitoring
---
# Grafanas admin. Används via grafana.admin.existingSecret i
# kubernetes/values/monitoring.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: monitoring
type: Opaque
data:
  admin-user: {{ 'admin' | b64encode }}
  admin-password: {{ app_secrets_grafana_admin_password | b64encode }}
---
# Webhooken som Alertmanager skickar larm till. Den monteras som en fil och
# läses med api_url_file, så den syns aldrig i Alertmanagers konfiguration.
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-mattermost
  namespace: monitoring
type: Opaque
data:
  url: {{ app_secrets_mattermost_webhook_url | b64encode }}
---
apiVersion: v1
kind: Namespace
metadata:
  name: synapse
---
# Synapse lösenord till Postgres och hemligheten för att skapa användare.
# Används via existingSecret i charts/synapse/values.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: synapse-secrets
  namespace: synapse
type: Opaque
data:
  postgres-password: {{ app_secrets_synapse_postgres_password | b64encode }}
  registration-shared-secret: {{ app_secrets_synapse_registration_shared_secret | b64encode }}
